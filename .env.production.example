# Copy this file to a root-readable location outside the checkout and replace
# every replace-me value. Pass it with `docker compose --env-file`.
COMPOSE_PROJECT_NAME=maas
MAAS_DOCKER_NETWORK_PREFIX=maas
MAAS_DOMAIN=chat.example.com
MAAS_ACME_EMAIL=operator@example.com
CLOUDFLARE_ANALYTICS_SITE_TOKEN=replace-me-cloudflare-web-analytics-site-token
CLOUDFLARE_ACCOUNT_ID=replace-me-cloudflare-account-id
CLOUDFLARE_ANALYTICS_API_TOKEN=replace-me-cloudflare-analytics-read-api-token
# Mount this instance into both application containers. The reusable images do
# not include private profile data.
MAAS_INSTANCE_DIR_HOST=./examples/fictional-profile
# Direct deployment trusts no public forwarding proxy. Set trusted CDN egress
# CIDRs as a comma-separated list only when a CDN is actually in front.
MAAS_TRAEFIK_TRUSTED_IPS=127.0.0.1/32

POSTGRES_DB=maas
POSTGRES_USER=maas
POSTGRES_PASSWORD=replace-me-postgres-password
DATABASE_URL=postgresql://maas:replace-me-postgres-password@postgres:5432/maas

MAAS_LLM_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=replace-me
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=me-as-a-service
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
MAAS_CONVERSATION_STORE=postgres
MAAS_CONVERSATION_RETENTION_HOURS=24
MAAS_MAX_TURNS_PER_CONVERSATION=20
MAAS_DAILY_TOKEN_BUDGET=100000
MAAS_MAX_OUTPUT_TOKENS=300
MAAS_IP_RATE_LIMIT_REQUESTS=30
MAAS_SESSION_RATE_LIMIT_REQUESTS=12
MAAS_RATE_LIMIT_WINDOW_SECONDS=60
MAAS_MAX_CONCURRENT_TURNS=4
MAAS_MAX_QUEUED_TURNS=8
MAAS_QUEUE_TIMEOUT_SECONDS=15
MAAS_GRACEFUL_SHUTDOWN_SECONDS=30
MAAS_PROXY_SHARED_SECRET=replace-me-with-an-independent-random-secret

# This host path must contain only the metrics bearer token and be readable by
# the containers. Keep it outside Git, for example /etc/maas/metrics-token.
MAAS_METRICS_BEARER_TOKEN_FILE_HOST=/etc/maas/metrics-token

# Client-side encrypted restic backups to any S3-compatible object store.
RESTIC_REPOSITORY=s3:https://s3.example.com/maas-production-backups
RESTIC_PASSWORD_FILE_HOST=/etc/maas/restic-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=replace-me-region
MAAS_BACKUP_RETENTION_DAILY=7
MAAS_BACKUP_RETENTION_WEEKLY=4

# Grafana is exposed on host loopback only for an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me-with-an-independent-random-password
# Replace with a root-readable Alertmanager configuration to enable delivery.
MAAS_ALERTMANAGER_CONFIG=./deploy/alertmanager/alertmanager.example.yml
