MAAS_API_BASE_URL=http://127.0.0.1:8000
MAAS_INSTANCE_DIR=instance/example
MAAS_CONVERSATION_STORE=postgres
DATABASE_URL=postgresql://maas:maas@127.0.0.1:5432/maas
MAAS_CONVERSATION_RETENTION_HOURS=24
MAAS_MAX_TURNS_PER_CONVERSATION=20
MAAS_DAILY_TOKEN_BUDGET=100000
MAAS_MAX_OUTPUT_TOKENS=300
MAAS_LLM_PROVIDER=openai
MAAS_LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MAAS_IP_RATE_LIMIT_REQUESTS=30
MAAS_SESSION_RATE_LIMIT_REQUESTS=12
MAAS_RATE_LIMIT_WINDOW_SECONDS=60
MAAS_MAX_CONCURRENT_TURNS=4
MAAS_MAX_QUEUED_TURNS=8
MAAS_QUEUE_TIMEOUT_SECONDS=15

# Set both secrets in production. MAAS_PROXY_SHARED_SECRET must have the same
# value in the web and API services. Keep the API private behind the web proxy.
MAAS_PROXY_SHARED_SECRET=
MAAS_METRICS_BEARER_TOKEN=
# Alternatively, point the API at a file containing only the bearer token.
# MAAS_METRICS_BEARER_TOKEN_FILE=/run/secrets/metrics_bearer_token

# Use MAAS_CONVERSATION_STORE=memory to run without PostgreSQL.

# Cloudflare Web Analytics site token (Cloudflare dashboard > Web Analytics).
# Server-only Cloudflare GraphQL configuration for the public 7-day visit
# counter. MAAS_DOMAIN must match the hostname registered with Web Analytics.
MAAS_DOMAIN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_ANALYTICS_SITE_TOKEN=

# Optional LangSmith tracing. Production prompts always come from Git-owned
# files under apps/api/src/me_as_a_service/chat/prompts, never from LangSmith.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=me-as-a-service
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
